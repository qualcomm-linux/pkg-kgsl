#!/bin/bash
set -e

#DEBHELPER#

case "$1" in
    configure)
	# Ensure msm_kgsl will be included in initramfs.
	#
	# The 'options msm skip_gpu=1' in kgsl-dkms.conf prevents the DRM msm
	# driver from claiming the GPU; msm_kgsl.ko must be present inside the
	# initramfs so the 'softdep msm post: msm_kgsl' directive can load it
	# immediately after msm during early boot.
        INITRAMFS_MODULES=/etc/initramfs-tools/modules
        if [ -f "$INITRAMFS_MODULES" ]; then
            if ! grep -qx 'msm_kgsl' "$INITRAMFS_MODULES"; then
                echo 'msm_kgsl' >> "$INITRAMFS_MODULES"
            fi
        fi

	# Rebuild initramfs with modprobe.d/kgsl-dkms.conf and msm_kgsl.ko
        if command -v update-initramfs > /dev/null 2>&1; then
            update-initramfs -u -k all || true
        fi
	;;
esac
