#!/bin/bash
set -e

#DEBHELPER#

case "$1" in
    configure)
        # According to dkms(8), dkms will fail with return code 77 when the module
	# should not be built, but `dkms autoinstall` will ignore the error and
	# display a warning instead.
	#
	# Make sure msm_kgsl has been installed by dkms autoinstall if it is
	# enabled, since it might be skipped because of missing kernel options.
        if ! [ -f /etc/dkms/no-autoinstall ] && ! dkms status | grep -qx 'kgsl/.*: installed' ; then
            >&2 echo "ERROR: msm_kgsl was not installed by dkms autoinstall, has your kernel the required options?"
            exit 1
        fi
        ;;
esac
